# Tempest — Environment Configuration
# Copy this file to .env and customise for your environment.
# Variables defined here override values in config.json.
# .env is gitignored and never committed.

# Server
TEMPEST_HOST=127.0.0.1
TEMPEST_PORT=8377

# Database (absolute path recommended in production)
TEMPEST_DB_PATH=tempest.db

# Engine
TEMPEST_MAX_SESSIONS=500
TEMPEST_ANNOUNCE_PORT=6881
TEMPEST_ENABLE_RANDOMIZATION=true

# Security: leave false unless this instance is isolated and must reach an
# authorised tracker on a private, loopback, or link-local destination.
TEMPEST_ALLOW_PRIVATE_TRACKERS=false
